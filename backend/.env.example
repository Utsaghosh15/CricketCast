PORT=3001
# Local Docker: docker compose up -d postgres redis
# DATABASE_URL must match docker-compose postgres user/password/db (default criccast/criccast/criccast).
# If you see "password authentication failed for user criccast": Postgres is running but credentials
# do not match. Common fix after changing POSTGRES_PASSWORD: remove the old volume so init runs again:
#   docker compose down -v && docker compose up -d postgres redis
# (This wipes local DB data.) Or set DATABASE_URL to the password your cluster was actually created with.
DATABASE_URL=postgresql://criccast:criccast@localhost:5432/criccast
REDIS_URL=redis://localhost:6379
# Scorer login: POST /api/auth/admin-login (defaults: admin / criccast). JWT signing uses ADMIN_SECRET.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=criccast
ADMIN_SECRET=criccast
# JWT for viewer sessions after /api/auth/viewer-login (defaults to ADMIN_SECRET if unset)
VIEWER_JWT_SECRET=
# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional; defaults to LIVEKIT_API_SECRET if unset
LIVEKIT_WEBHOOK_SECRET=
# Frontend dev origins (comma-separated) for browser CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: email room-guest invites (POST /room-guests). If SMTP_HOST or INVITE_EMAIL_FROM is unset, no mail is sent.
# Base URL of the Vite app; invite links use /watch/<matchId> (e.g. http://localhost:5173/watch/uuid).
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITE_EMAIL_FROM=
