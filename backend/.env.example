PORT=3001
# Local Docker: docker compose up -d postgres redis
# DATABASE_URL must match docker-compose postgres user/password/db (default criccast/criccast/criccast).
# If you see "password authentication failed for user criccast": Postgres is running but credentials
# do not match. Common fix after changing POSTGRES_PASSWORD: remove the old volume so init runs again:
#   docker compose down -v && docker compose up -d postgres redis
# (This wipes local DB data.) Or set DATABASE_URL to the password your cluster was actually created with.
DATABASE_URL=postgresql://criccast:criccast@localhost:5432/criccast
REDIS_URL=redis://localhost:6379
ADMIN_SECRET=your_admin_secret_here
# Frontend dev origins (comma-separated) for browser CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
