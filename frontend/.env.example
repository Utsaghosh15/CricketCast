# Copy to .env and adjust for your environment (never commit .env)
#
# Dev: you can omit VITE_API_URL and VITE_WS_URL — Vite proxies /api and /ws to the backend
# (see vite.config.js, default target http://127.0.0.1:3001). Then the browser talks only to
# the dev server (e.g. :5173) and avoids 404s from requests accidentally hitting Vite.
#
# Production or explicit dev against another host: set both.
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001/ws
# Optional legacy: X-Admin-Secret if you do not use admin JWT from /api/auth/admin-login
# VITE_ADMIN_SECRET=
VITE_WEBRTC_ASSUMED_LATENCY_S=0.4
# Room guests API uses Bearer token after admin sign-in (same origin as VITE_API_URL).
